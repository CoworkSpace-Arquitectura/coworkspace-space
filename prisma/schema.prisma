generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id          String          @id @default(uuid())
  name        String
  city        String
  address     String
  country     String          @default("CO")
  currency    String          @default("COP")
  /// Zona horaria IANA de la sede (ej. Europe/Madrid): las horas de reserva se eligen en esta zona
  timeZone    String          @default("America/Bogota") @map("time_zone")
  description String          @default("")
  amenities   String[]        @default([])
  latitude    Float?
  longitude   Float?
  managerId   String?         @map("manager_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  rooms       Room[]
  desks       Desk[]
  photos      LocationPhoto[]

  @@index([country])
  @@index([managerId])
  @@map("locations")
}

model LocationPhoto {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  url        String?
  data       Bytes?
  mimeType   String?  @map("mime_type")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("location_photos")
}

enum RoomKind {
  MEETING_ROOM
  PRIVATE_OFFICE
  AUDITORIUM
  PHONE_BOOTH
}

model Room {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  name       String
  kind       RoomKind @default(MEETING_ROOM)
  capacity   Int
  equipment  Json     @default("{}")
  hourlyRate Int      @default(30000) @map("hourly_rate")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("rooms")
}

model Desk {
  id          String   @id @default(uuid())
  locationId  String   @map("location_id")
  code        String
  isDedicated Boolean  @default(false) @map("is_dedicated")
  hourlyRate  Int      @default(15000) @map("hourly_rate")
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("desks")
}
