generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id        String   @id @default(uuid())
  name      String
  city      String
  address   String
  country   String   @default("CO")
  currency  String   @default("COP")
  createdAt DateTime @default(now()) @map("created_at")
  rooms     Room[]
  desks     Desk[]

  @@index([country])
  @@map("locations")
}

model Room {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  name       String
  capacity   Int
  equipment  Json     @default("{}")
  hourlyRate Int      @default(30000) @map("hourly_rate")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("rooms")
}

model Desk {
  id          String   @id @default(uuid())
  locationId  String   @map("location_id")
  code        String
  isDedicated Boolean  @default(false) @map("is_dedicated")
  hourlyRate  Int      @default(15000) @map("hourly_rate")
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@map("desks")
}